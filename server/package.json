{
  "name": "kingermeat-backend",
  "version": "2.3.4",
  "description": "REST API för Kinger Meat — hanterar produkter, kategorier och lagerstatus",
  "bin": {
    "kingermeat": "./bin/kingermeat"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "demo": "tsx src/index.ts",
    "start": "NODE_ENV=production sh -c 'prisma migrate deploy && node dist/index.js'",
    "cli": "tsx src/cli/cli.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "keywords": [],
  "author": "tlxq",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "commander": "^14.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "picocolors": "^1.1.1",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "prisma": "^6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  }
}
